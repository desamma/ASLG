  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "        \"Before the age of kingdoms, the world was kept in balance by
    the Sacred Grounds \u2014 \" +\r\n        \"ancient sanctuaries where the boundary
    between realms grew thin, and the power of creation \" +\r\n        \"itself
    lay dormant within colossal Monoliths.\\n\\n\" +\r\n        \"For centuries,
    the Royal Army stood watch over these places, \" +\r\n        \"guarding them
    from those who would corrupt their light.\\n\\n\" +\r\n        \"Then the sky
    tore open.\\n\\n\" +\r\n        \"Rifts now scar the heavens \u2014 wounds that
    bridge the Outside World and the Sacred Grounds, \" +\r\n        \"bleeding darkness
    into the sanctuaries and awakening horrors long sealed away.\\n\\n\" +\r\n       
    \"The Monolith of the Sun has gone silent. The King has issued a decree. \" +\r\n       
    \"And somewhere, in the ruins of a soldier's camp, a single pair of eyes opens.\""
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8a89fa14b10d46a99122fd4f73fca9a2, type: 2}
  m_sharedMaterial: {fileID: 2140474, guid: 8a89fa14b10d46a99122fd4f73fca9a2, type: 2}
