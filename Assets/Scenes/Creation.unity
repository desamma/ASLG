  loreFadeInTime: 1.4
  footerFadeInTime: 0.8
  buttonFadeInTime: 0.9
  delayBetweenElements: 0.6
  exitFadeOutTime: 1.2
  useTypewriter: 1
  typewriterSpeed: 0.015
  loreTitle: "IN THE BEGINNING\u2026"
  loreBody: "Before the age of kingdoms, the world was kept in balance by the Sacred
    Grounds \u2014 ancient sanctuaries where the boundary between realms grew thin,
    and the power of creation itself lay dormant within colossal Monoliths.\n\nFor
    centuries, the Royal Army stood watch over these places, guarding them from those
    who would corrupt their light.\n\nThen the sky tore open.\n\nRifts now scar the
    heavens \u2014 wounds that bridge the Outside World and the Sacred Grounds, bleeding
    darkness into the sanctuaries and awakening horrors long sealed away.\n\nThe
    Monolith of the Sun has gone silent. The King has issued a decree. And somewhere,
    in the ruins of a soldier's camp, a single pair of eyes opens."
  loreFooter: Your story begins now.
  buttonText: Let's Get Started
  characterCreation: {fileID: 749553471}
